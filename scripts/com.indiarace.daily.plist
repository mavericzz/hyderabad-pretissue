<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  IndiaRace card scrape, Night/Morning/Opening odds, HCP / LTO rebuild,
  and GitHub Pages push — one job.

  Schedule: every 15 minutes. The shell skips hours outside
  06-16 and 18-21 IST so night books, morning quotes and opening
  prices all land without hammering IndiaRace overnight.

  Install:
    mkdir -p ~/Library/Application\ Support/IndiaRace
    cp scripts/run_indiarace_daily.sh ~/Library/Application\ Support/IndiaRace/
    cp scripts/com.indiarace.daily.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.indiarace.daily.plist 2>/dev/null || true
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.indiarace.daily.plist

  Run now (ignores the hour gate):
    npm run daily:ship
    # or: INDIARACE_SKIP_DEPLOY=1 npm run daily -- --from 2026-09-20 --days 3 --fresh

  Logs:
    db/migrations/IndiaRace/logs/indiarace_daily_YYYY-MM-DD.log

  After a successful scrape the job commits src/meetings and pushes
  origin/main, which deploys GitHub Pages:
    https://mavericzz.github.io/hyderabad-pretissue/
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.indiarace.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/toshasharma/Library/Application Support/IndiaRace/run_indiarace_daily.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>StandardOutPath</key>
    <string>/Users/toshasharma/Downloads/Github/thoroughbred/db/migrations/IndiaRace/logs/launchd_indiarace_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/toshasharma/Downloads/Github/thoroughbred/db/migrations/IndiaRace/logs/launchd_indiarace_stderr.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/toshasharma</string>
        <key>TZ</key>
        <string>Asia/Kolkata</string>
        <key>INDIARACE_CRON</key>
        <string>1</string>
        <key>INDIARACE_ROOT</key>
        <string>/Users/toshasharma/Downloads/Github/thoroughbred/db/migrations/IndiaRace</string>
    </dict>
</dict>
</plist>
